{
  "name": "signet-lite",
  "version": "0.13.2",
  "description": "My Signet Lite — a web-based Nostr remote signer (NIP-46) PWA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgesworn/signet-lite.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
